# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Alpaca (free paper-trading account) — https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex

# Alpha Vantage (free tier, 25 requests/day) — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Kafka broker reachable from the host (only used if you run the producers
# from a host Python venv instead of via `docker compose up` in streaming/,
# which sets this to kafka:29092 automatically)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# "replay" (default) streams synthetic/cached data, no API keys needed.
# Set to "live" for real Alpaca/Alpha Vantage feeds once keys above are filled in.
STREAM_MODE=replay
