# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Alpaca (free paper-trading account) — https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex

# Alpha Vantage (free tier, 25 requests/day) — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Kafka broker reachable from the host (producers run outside docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Set to "replay" to stream recent historical data instead of live feeds
# (useful outside US market hours or when API quota is exhausted)
STREAM_MODE=live
