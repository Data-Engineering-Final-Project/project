# Docker & local volumes
# data/ keeps its bronze/silver/gold layer structure in git (that's the
# layout the lecturer asked for) but not the actual downloaded/generated
# files -- those are regenerated by processing/jobs/download_yahoo.py and
# the streaming producers' Alpha Vantage cache.
data/bronze/yahoo/*
!data/bronze/yahoo/.gitkeep
data/bronze/alpaca/*
!data/bronze/alpaca/.gitkeep
data/bronze/alpha_vantage/*
!data/bronze/alpha_vantage/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep
**/volumes/
minio-data/
postgres-data/
kafka-data/
zookeeper-data/
processing/warehouse/*
!processing/warehouse/.gitkeep
processing/notebooks/*
!processing/notebooks/.gitkeep

